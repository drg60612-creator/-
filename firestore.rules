rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Shared Team Workspace
    match /team/{teamId} {
      allow read, write: if true;
    }

    match /team/medical_support/members/{memberId} {
      allow read, write: if true;
    }

    match /team/medical_support/shifts/{shiftId} {
      allow read, write: if true;
    }

    match /team/medical_support/dayApprovals/{dateId} {
      allow read, write: if true;
    }

    match /team/medical_support/serviceLocations/{locationId} {
      allow read, write: if true;
    }

    match /team/medical_support/periods/{periodId} {
      allow read, write: if true;
    }

    match /team/medical_support/auditLogs/{logId} {
      allow read, write: if true;
    }

    // Direct root collections and nested fallbacks
    match /members/{memberId} {
      allow read, write: if true;
    }

    match /shifts/{shiftId} {
      allow read, write: if true;
    }

    match /dayApprovals/{dateId} {
      allow read, write: if true;
    }

    match /serviceLocations/{locationId} {
      allow read, write: if true;
    }

    match /periods/{periodId} {
      allow read, write: if true;
    }

    match /auditLogs/{logId} {
      allow read, write: if true;
    }

    match /{document=**} {
      allow read, write: if true;
    }
  }
}
